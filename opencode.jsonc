{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    // The token can only call /chat/completions, so the model is declared here.
    "bayleaf-review-bot": {
      "name": "BayLeaf (review bot token)",
      "env": ["REVIEW_BOT_TOKEN"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "https://api.bayleaf.dev/v1" },
      "models": {
        "glm": {
          "modelID": "openrouter:z-ai/glm-5.3-flash",
          "name": "GLM 5.3 Flash",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 128000, "output": 16384 }
        }
      }
    }
  }
}
