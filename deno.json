{
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "fmt": {
    "lineWidth": 100,
    "proseWrap": "preserve"
  },
  "tasks": {
    "dev": "deno run -A npm:vite@8.3.1",
    "build": "deno run -A npm:vite@8.3.1 build",
    "check": "deno check src/**/*.ts trainer/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "ci": "deno fmt --check && deno lint && deno task check && deno task build",
    "trainer:setup": "deno run --allow-net --allow-read=.env --allow-write=.env --allow-env --allow-run trainer/setup.ts",
    "review": "deno run --allow-env --allow-read --allow-write --allow-net --allow-run=git trainer/review.ts"
  },
  "exclude": ["node_modules", "dist", ".git"]
}
